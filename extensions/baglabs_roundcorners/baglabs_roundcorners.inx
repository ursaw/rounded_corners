<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Baglabs RoundCorners</name>
  <id>baglabs.roundcorners</id>
  <param name="length" type="float" min="0" max="1000" precision="2" gui-text="Länge (L) [cm]">50</param>
  <param name="width" type="float" min="0" max="1000" precision="2" gui-text="Breite (Br) [cm]">30</param>
  <param name="height" type="float" min="0" max="1000" precision="2" gui-text="Höhe (Ho) [cm]">30</param>
  <param name="segment_height" type="float" min="0" max="1000" precision="2" gui-text="Segmenthöhe (Hs) [cm]">20</param>
  <param name="radius_top" type="float" min="0" max="1000" precision="2" gui-text="Radius Top (Rt) [cm]">11</param>
  <param name="radius_bottom" type="float" min="0" max="1000" precision="2" gui-text="Radius Bottom (Rb) [cm]">5</param>
  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu _name="Baglabs" name="Baglabs">
        <submenu _name="Parts" name="Parts"/>
      </submenu>
    </effects-menu>
    <menu-tip>Plots the UPPER and LOWER sewing patches (cm).</menu-tip>
  </effect>
   <script>
        <command location="inx" interpreter="python">baglabs_roundcorners.py</command>
    </script>
  </inkscape-extension>